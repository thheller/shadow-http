{:paths
 ["src/dev"
  "src/main"
  "src/java"
  "src/test"
  "target/classes"
  "target/test-classes"]

 :deps
 {}

 :aliases
 {:dev
  {:extra-deps
   {thheller/shadow-cljs {:mvn/version "3.3.6"}
    org.junit.jupiter/junit-jupiter-api {:mvn/version "5.9.2"}
    org.junit.jupiter/junit-jupiter-engine {:mvn/version "5.9.2"}
    org.openjdk.jmh/jmh-core {:mvn/version "1.37"}
    org.openjdk.jmh/jmh-generator-annprocess {:mvn/version "1.37"}
    criterium/criterium {:mvn/version "0.4.6"}
    com.clojure-goes-fast/clj-async-profiler {:mvn/version "2.0.0-beta1"}
    }

   :jvm-opts ["-Djdk.attach.allowAttachSelf"]}

  :start
  {:main-opts ["-m" "repl"]
   }

  ;; java classes must be compiled first: mvn compile && clojure -M:test
  :test
  {:extra-deps
   {ring/ring-core {:mvn/version "1.15.6"}
    org.clojure/core.async {:mvn/version "1.9.865"}
    io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "src/test" "-r" "shadow\\.http\\.server\\..*-test$"]}}}